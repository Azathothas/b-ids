{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azathothas/b-ids/schema/browser-profile-1.schema.json",
  "title": "browser-profile/1",
  "description": "One browser, one build, one platform, one channel, one instant. The Rust types in b-ids-schema are checked against this file rather than the other way round.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "browser",
    "platform",
    "captured",
    "tls",
    "http2",
    "http",
    "digests",
    "raw",
    "provenance",
    "supersedes"
  ],
  "properties": {
    "schema": {
      "const": "browser-profile/1"
    },
    "id": {
      "type": "string",
      "description": "Derived from the four keys, not a hash, so a published path can be built without an index."
    },
    "browser": {
      "$ref": "#/$defs/browser"
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "captured": {
      "$ref": "#/$defs/captured"
    },
    "tls": {
      "$ref": "#/$defs/tls"
    },
    "http2": {
      "$ref": "#/$defs/http2"
    },
    "http": {
      "$ref": "#/$defs/http"
    },
    "digests": {
      "$ref": "#/$defs/digests"
    },
    "raw": {
      "$ref": "#/$defs/raw"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "description": "A published profile is immutable. A correction is a new profile naming the one it replaces."
    }
  },
  "$defs": {
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "A byte on the wire. The bound is the Rust width this field is read into, so a value the implementation cannot hold is refused by the published contract too."
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "A two-byte value on the wire, bounded by the Rust width it is read into."
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "A four-byte value on the wire, bounded by the Rust width it is read into."
    },
    "hex": {
      "type": "string"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "major",
        "channel",
        "branded"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "The exact build, never a major alone."
        },
        "major": {
          "$ref": "#/$defs/u32"
        },
        "channel": {
          "enum": [
            "stable",
            "beta",
            "dev",
            "nightly",
            "canary",
            "esr"
          ],
          "description": "latest is not a channel. It means stable and nothing else."
        },
        "branded": {
          "type": "boolean"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "distribution"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux",
            "windows",
            "mac",
            "android",
            "ios"
          ]
        },
        "arch": {
          "type": "string"
        },
        "distribution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "captured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "method",
        "harness",
        "operator",
        "trust",
        "switches"
      ],
      "properties": {
        "at": {
          "type": "string",
          "description": "ISO 8601 UTC, and never optional."
        },
        "method": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "trust": {
          "enum": [
            "not-applicable",
            "spki-pin",
            "trust-store",
            "verification-disabled"
          ],
          "description": "How the subject came to trust the harness. A condition of the measurement: a profile carrying both a ClientHello and HTTP/2 frames may not be not-applicable."
        },
        "resumption": {
          "enum": [
            "offered",
            "refused"
          ],
          "description": "Whether the harness offered the subject a way to resume a session. A condition of the measurement: a server that issues session tickets lets the subject resume, and a resumed hello offers a pre-shared key where a cold one offers an empty session ticket. ABSENT rather than defaulted on a profile written before the field existed, because a condition nobody recorded is not a condition somebody measured."
        },
        "switches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The switches the subject was launched with, in order. Every one is a condition of what was captured through it."
        },
        "acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "url",
            "sha256",
            "bytes"
          ],
          "description": "Where the build came from, when this project fetched it. Absent where nothing was fetched, which is a different fact from an acquisition that failed. The URL is recorded and the artefact never is.",
          "properties": {
            "route": {
              "enum": [
                "installed",
                "cache",
                "chrome-for-testing"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "How many bytes arrived. The ceiling is the largest integer a JSON number carries exactly, because a consumer that read a larger one would read a different number than was written."
            }
          }
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codepoint",
        "length",
        "body_hex"
      ],
      "properties": {
        "codepoint": {
          "$ref": "#/$defs/u16"
        },
        "length": {
          "$ref": "#/$defs/u16"
        },
        "body_hex": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "key_share": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "entry_len"
      ],
      "properties": {
        "group": {
          "$ref": "#/$defs/u16"
        },
        "entry_len": {
          "$ref": "#/$defs/u16"
        }
      }
    },
    "ech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "kem_id"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/u8"
        },
        "kem_id": {
          "$ref": "#/$defs/u16"
        }
      }
    },
    "shuffle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "draws"
          ],
          "properties": {
            "state": {
              "enum": [
                "observed",
                "fixed"
              ]
            },
            "draws": {
              "$ref": "#/$defs/u32"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "grease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_positions",
        "values",
        "distinct",
        "bodies_hex"
      ],
      "properties": {
        "extension_positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u32"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u16"
          }
        },
        "distinct": {
          "type": "boolean"
        },
        "bodies_hex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_version",
        "legacy_version",
        "session_id_len",
        "session_id_hex",
        "cipher_suites",
        "compression_methods",
        "extensions",
        "key_exchange_groups",
        "key_shares",
        "signature_algorithms",
        "signature_algorithms_cert",
        "alpn",
        "ech",
        "padding_len",
        "shuffled",
        "grease"
      ],
      "properties": {
        "record_version": {
          "$ref": "#/$defs/u16"
        },
        "legacy_version": {
          "$ref": "#/$defs/u16"
        },
        "session_id_len": {
          "$ref": "#/$defs/u8"
        },
        "session_id_hex": {
          "$ref": "#/$defs/hex"
        },
        "cipher_suites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u16"
          }
        },
        "compression_methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u8"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "description": "Ordered, keyed by codepoint, with an arbitrary body. An unknown codepoint is kept with its bytes, never dropped and never named as a typed field."
        },
        "key_exchange_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u16"
          }
        },
        "key_shares": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key_share"
          }
        },
        "signature_algorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u16"
          }
        },
        "signature_algorithms_cert": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/u16"
          }
        },
        "alpn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ech": {
          "oneOf": [
            {
              "$ref": "#/$defs/ech"
            },
            {
              "type": "null"
            }
          ]
        },
        "padding_len": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535,
          "description": "The padding extension's length, bounded by the Rust width it is read into. Absent where the extension was not sent."
        },
        "shuffled": {
          "$ref": "#/$defs/shuffle"
        },
        "grease": {
          "$ref": "#/$defs/grease"
        }
      }
    },
    "setting_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/u16"
        },
        "value": {
          "$ref": "#/$defs/u32"
        }
      }
    },
    "frame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "entries"
          ],
          "properties": {
            "frame": {
              "const": "settings"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/setting_entry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "window_size_increment"
          ],
          "properties": {
            "frame": {
              "const": "window_update"
            },
            "window_size_increment": {
              "$ref": "#/$defs/u32",
              "description": "The increment, which is the window minus the protocol's own 65535 default."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "stream_id",
            "has_priority_block"
          ],
          "properties": {
            "frame": {
              "const": "headers"
            },
            "stream_id": {
              "$ref": "#/$defs/u32"
            },
            "has_priority_block": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "frame_type",
            "payload_hex"
          ],
          "properties": {
            "frame": {
              "const": "other"
            },
            "frame_type": {
              "$ref": "#/$defs/u8"
            },
            "payload_hex": {
              "$ref": "#/$defs/hex"
            }
          }
        }
      ]
    },
    "stream_priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusive",
        "stream_dependency",
        "weight_wire"
      ],
      "properties": {
        "exclusive": {
          "type": "boolean"
        },
        "stream_dependency": {
          "$ref": "#/$defs/u32"
        },
        "weight_wire": {
          "$ref": "#/$defs/u8",
          "description": "The weight as encoded, which HTTP/2 defines as the weight minus one."
        }
      }
    },
    "priority_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "priority"
      ],
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/u32"
        },
        "priority": {
          "$ref": "#/$defs/stream_priority"
        }
      }
    },
    "http2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames",
        "stream_priority",
        "priority_frames",
        "pseudo_header_order",
        "connection_window"
      ],
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "description": "Ordered. An absent setting is expressed by omission and never as a default value."
        },
        "stream_priority": {
          "oneOf": [
            {
              "$ref": "#/$defs/stream_priority"
            },
            {
              "type": "null"
            }
          ],
          "description": "null means no block was sent, which is a measurement."
        },
        "priority_frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/priority_frame"
          }
        },
        "pseudo_header_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connection_window": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295,
          "description": "The window in the human unit, carried beside the increment rather than instead of it. A check asserts they differ by the protocol default."
        }
      }
    },
    "header_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "Absent under the default policy. Present only where values were deliberately recorded, and never for cookie or authorization."
        },
        "withheld": {
          "type": "boolean",
          "description": "The header carried a credential and its value is withheld by construction. Whether the header was sent, and where in the order, is a fingerprint signal that carries no secret; the value never appears on any surface. Absent means false. A true here beside a value, or on a name that is not cookie or authorization, is refused."
        }
      }
    },
    "header_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "headers"
      ],
      "properties": {
        "variant": {
          "enum": [
            "navigate",
            "subresource",
            "reload"
          ]
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/header_field"
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variants"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/header_set"
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja3",
        "ja4",
        "ja4_r",
        "ja4_ro",
        "akamai"
      ],
      "description": "Derived, and a sibling of the measured halves rather than inside one. None of them is a key.",
      "properties": {
        "ja3": {
          "type": [
            "string",
            "null"
          ]
        },
        "ja4": {
          "type": [
            "string",
            "null"
          ]
        },
        "ja4_r": {
          "type": [
            "string",
            "null"
          ]
        },
        "ja4_ro": {
          "type": [
            "string",
            "null"
          ]
        },
        "akamai": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_hello_hex",
        "settings_frame_hex"
      ],
      "properties": {
        "client_hello_hex": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings_frame_hex": {
          "type": [
            "string",
            "null"
          ]
        },
        "http2_frames_hex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          }
        },
        "request_line_hex": {
          "type": [
            "string",
            "null"
          ]
        },
        "connection_hex": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_layer": {
          "oneOf": [
            {
              "$ref": "#/$defs/record_layer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Per field, keyed by the field's dotted path. The value is a kind, optionally followed by a colon and a reason.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "record_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "declared_length",
        "bytes_arrived",
        "fragmented"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/u16"
        },
        "declared_length": {
          "$ref": "#/$defs/u16"
        },
        "bytes_arrived": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "How many bytes of the record arrived. The ceiling is the largest integer a JSON number carries exactly."
        },
        "fragmented": {
          "type": "boolean"
        }
      }
    }
  }
}
